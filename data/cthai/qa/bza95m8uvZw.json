      "a_phonetic": "mâi bòk khâ pàak-nǎak",
      "a_es": "mâi bok kâ pâk-nâk",
      "a_tone": "m-m-f-m-m-m",
      "a_spanish": "No, reservado.",
      "a_en": "No, won't tell.",
      "category": "conversacion"
    },
    {
